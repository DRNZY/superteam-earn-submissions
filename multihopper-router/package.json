{
  "name": "multihopper-router",
  "version": "1.0.0",
  "description": "Clean Solana transfer & multi-hop routing tool with TRM Labs compliance and fee revenue accounting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "multihopper": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/**/*.test.ts",
    "router": "node --import tsx src/cli.ts",
